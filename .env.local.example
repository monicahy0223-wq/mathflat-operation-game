# ──────────────────────────────────────────────────────────────────────────────
# Mathflat CMS API credentials
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# Server-only auth token for the Mathflat CMS API.
# Used by: app/api/mathflat-problems/route.ts
# Never expose this value on the client side (no NEXT_PUBLIC_ prefix).
MATHFLAT_AUTH_TOKEN=your_x_auth_token_here
